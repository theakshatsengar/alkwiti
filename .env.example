# ALKWITI dashboard — environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# Only VITE_* variables are exposed to the browser (safe: the anon/publishable key is public).
# Do NOT wrap values in quotes and do NOT put a space after the `=`.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co  (no trailing /rest/v1)
VITE_SUPABASE_URL=

# Supabase publishable/anon key (Project Settings → API Keys → Publishable key)
VITE_SUPABASE_ANON_KEY=

# --- Notion (finance data source) — SERVER ONLY, do NOT prefix with VITE_ ---
# The token is a secret; it must never reach the browser. Leave these blank to
# run on built-in sample data instead.

# Internal integration secret (Notion → Settings → Integrations → your integration)
NOTION_TOKEN=

# Database IDs (open the database as a full page; the ID is the 32-char part of the URL)
NOTION_REVENUE_DB_ID=
NOTION_EXPENSES_DB_ID=
