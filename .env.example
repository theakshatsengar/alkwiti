# ALKWITI dashboard — environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# Only VITE_* variables are exposed to the browser (safe: the anon key is public).

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (Project Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=
